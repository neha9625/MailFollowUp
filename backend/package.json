{
  "name": "gmail-followup-backend",
  "version": "1.0.0",
  "description": "Gmail Email Follow-up Automation System - Express + MySQL + Gmail API backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node src/scripts/migrate.js",
